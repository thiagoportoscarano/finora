# Ambiente: development ou production
APP_ENV=development

# PostgreSQL usado pelo Docker Compose
POSTGRES_DB=finora
POSTGRES_USER=finora
POSTGRES_PASSWORD=

# Gere uma chave local antes de iniciar a API:
# python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=
JWT_ALGORITHM=HS256
ACCESS_TOKEN_MINUTES=15
REFRESH_TOKEN_DAYS=7
PASSWORD_RESET_MINUTES=30

# Cookies locais. Em produção, use HTTPS e COOKIE_SECURE=true.
COOKIE_SECURE=false
COOKIE_SAMESITE=lax
COOKIE_DOMAIN=

# Origens locais permitidas
FRONTEND_URL=http://localhost:5173
CORS_ORIGINS=http://localhost:5173

# console: registra link de recuperação no terminal, somente em desenvolvimento
# smtp: envia e-mail real; exige configuração do provedor
EMAIL_BACKEND=console
EMAIL_FROM=
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_STARTTLS=true
